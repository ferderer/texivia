{
  "name": "texivia-component",
  "version": "1.0.0",
  "description": "Component factory with reactive state, @bind, and event delegation — part of the Texivia ecosystem",
  "author": "Vadim Ferderer (https://ferderer.de/)",
  "license": "Apache-2.0",
  "type": "module",
  "main":   "dist/index.cjs",
  "module": "dist/index.mjs",
  "types":  "dist/index.d.ts",
  "files":  ["dist"],
  "exports": {
    ".": {
      "import":  { "types": "./dist/index.d.ts",  "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "scripts": {
    "build":     "vite build && tsc --emitDeclarationOnly && node ../../scripts/cts-types.mjs",
    "test":      "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["component", "reactive", "bind", "spa", "texivia"],
  "repository": { "type": "git", "url": "https://github.com/ferderer/texivia.git" },
  "dependencies": {
    "texivia-reactive": "^1.0.0"
  },
  "devDependencies": {
    "terser":     "^5.39.0",
    "typescript": "^5.6.3",
    "vite":       "^5.4.8",
    "vitest":     "^3.1.2"
  },
  "publishConfig": { "access": "public" }
}
